{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "lib": [
      "DOM",
      "ES2020"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../*"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts",
    "../app/pen/film",
    "../app/pen/landing-audiences.ts",
    "../app/pen/PenArt.tsx"
  ]
}
